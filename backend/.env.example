PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/cinephiles
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

TMDB_API_KEY=your_tmdb_api_key_here

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
